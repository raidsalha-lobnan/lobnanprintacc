              window.__wt_getLocalIsoTimestamp = function() {
                var now = new Date();
                var tzo = -now.getTimezoneOffset();
                var dif = tzo >= 0 ? '+' : '-';
                function pad(num, ms) {
                  var norm = Math.floor(Math.abs(num));
                  if (ms) return (norm < 10 ? '00' : norm < 100 ? '0' : '') + norm;
                  return (norm < 10 ? '0' : '') + norm;
                }
                return now.getFullYear()
                  + '-' + pad(now.getMonth() + 1)
                  + '-' + pad(now.getDate())
                  + 'T' + pad(now.getHours())
                  + ':' + pad(now.getMinutes())
                  + ':' + pad(now.getSeconds())
                  + '.' + pad(now.getMilliseconds(), true)
                  + dif + pad(tzo / 60)
                  + ':' + pad(tzo % 60);
              };
